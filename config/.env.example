# Public template only: never put real credentials in this file.
# Run `wald init` to create private config/.env; fill upstream keys there.
# config/ and this template can be committed; real .env files are excluded.
# Production refuses to start without service auth.
WALD_ENV=production
WALD_API_KEY=
# Optional named clients, isolated records and rate limits. JSON syntax:
# WALD_API_KEYS={"support":"replace-with-at-least-32-random-characters"}
ENABLED_PROVIDERS=["llm"]
# For HTTP Jev/image endpoints: ENABLED_PROVIDERS=["llm","jev"]

# Chat Completions compatible API, including its /v1 prefix.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# OPENAI_API_KEY is also accepted if LLM_API_KEY is not set.
LLM_MODEL=gpt-4o-mini
LLM_RESPONSE_FORMAT=json_schema
# Use json_object for providers without strict Structured Outputs.
# Local schema/probability validation remains enabled in either mode.
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TOKEN_LIMIT_FIELD=max_completion_tokens
# Older compatible providers may require: LLM_TOKEN_LIMIT_FIELD=max_tokens
# Optional: omit temperature for models that do not support it.
# LLM_TEMPERATURE=0

TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-1.13.0

# Image preprocessing uses a vision-capable Chat Completions model.
# Defaults to the LLM connection/key; override all three for another provider.
VISION_MODEL=gpt-4o-mini
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_API_KEY=

# Single service process per persistent database. Do not share over NFS.
DATABASE_PATH=data/wald.sqlite3
AUDIT_STORE_INPUTS=true
RETENTION_DAYS=30
MAX_CONCURRENT_REQUESTS=8
MAX_QUEUED_REQUESTS=32
QUEUE_TIMEOUT_SECONDS=5
RATE_LIMIT_PER_MINUTE=120
MAX_STATE_BYTES=256000
MAX_BODY_BYTES=16777216
BODY_TIMEOUT_SECONDS=15

# Total provider-call deadline includes all retry attempts and delays.
API_TIMEOUT_SECONDS=60
REQUEST_TIMEOUT_SECONDS=150
API_CONNECT_TIMEOUT_SECONDS=5
API_MAX_RETRIES=2
API_RETRY_BASE_SECONDS=0.5
API_RETRY_MAX_SECONDS=10
API_MAX_RESPONSE_BYTES=2097152
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SECONDS=30
LOG_LEVEL=INFO
